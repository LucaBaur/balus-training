# Vorlage: kopieren nach deploy.env (wird nicht eingecheckt) und ausfuellen.
DEPLOY_HOST=benutzer@server-adresse        # SSH-Ziel, Schluessel-Login ohne Passwort
DEPLOY_DIR=elo                             # Projektordner auf dem Server, relativ zum Home
DEPLOY_SERVICE=elo                         # systemd-User-Service
DEPLOY_URL=http://127.0.0.1:8200           # wird auf dem Server selbst abgefragt
