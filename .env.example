# Kopiere diese Datei zu ".env" und trage deine Werte ein (gleiche wie beim
# SpielerPlus-Anytype-Sync). Wird nicht committet.

# Anytype-API-Key (Desktop: Einstellungen -> API Keys; Homeserver-Bot: eigener Key)
Api_key=dein_anytype_api_key

# Space-ID ("Frauen TVG")
ANYTYPE_SPACE_ID=deine_space_id

# API-Adresse. Leer = Desktop-App (31009). Auf dem Homeserver mit anytype-cli:
#ANYTYPE_API_BASE=http://127.0.0.1:31012/v1

# Property-Key fuer die ELO-Zahl am Spieler-Typ (Default "elo").
#ANYTYPE_ELO_KEY=elo
